# Variables to set on the hosting service (never commit real values)
DEBUG=0
SECRET_KEY=<long random string>
ALLOWED_HOSTS=crm.as-finances.co.il
CSRF_TRUSTED_ORIGINS=https://crm.as-finances.co.il
DATABASE_URL=<provided by the PostgreSQL service>
MEDIA_ROOT=/data/media
BACKUP_DIR=/data/backups
REQUIRE_2FA=1
ANTHROPIC_API_KEY=<your Anthropic API key, optional>
# CLAUDE_MODEL=claude-sonnet-5-5
# --- v6 security (REQUIRED online; losing these keys means losing the data, keep a copy somewhere safe) ---
FIELD_ENCRYPTION_KEY=<generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
ID_HASH_KEY=<generate the same way, a different value>
ADMIN_URL=<secret path ending with a slash, e.g. panel-8f3k2x9/>
# Antivirus (recommended): a ClamAV service
# CLAMAV_HOST=<host of the clamd service>
# CLAMAV_PORT=3310
# --- v10: website leads and business mailbox ---
LEAD_INTAKE_TOKEN=<long random string; the same value goes into the website function as INTAKE_TOKEN>
# MAIL_IMAP_USER=office@as-finances.com
# MAIL_IMAP_PASSWORD=<Google "App password">
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_OWN_ADDRESSES=office@as-finances.com

# --- Cloudflare R2 (file storage; optional, otherwise files stay on the server disk) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- free hosting (Render + Neon + R2) ---
# CRON_TOKEN=<long random string; used in the cron-job.org URLs /cron/tick/ and /cron/daily/>
# CLAUDE_MODEL=claude-haiku-5-5   (cheaper AI; claude-sonnet-5-5 is the default)
